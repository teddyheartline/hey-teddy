{
  "entities": {
    "User": {
      "title": "User",
      "description": "User public profile in the application",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_.]+$" },
        "email": { "type": "string", "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 2048 },
        "bio": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["client", "admin"] },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "postsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "displayName", "username", "role", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Mark of administrator privilege",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "initializedAt": { "type": "string" }
      },
      "required": ["uid", "email", "initializedAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Photographic or video post in the social feed",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorPhotoURL": { "type": "string", "maxLength": 2048 },
        "isAuthorAdmin": { "type": "boolean" },
        "mediaType": { "type": "string", "enum": ["photo", "video", "gallery"] },
        "mediaUrls": { "type": "array" },
        "caption": { "type": "string", "maxLength": 2200 },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "visibility": { "type": "string", "enum": ["public", "followers", "private"] },
        "galleryId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "authorId", "authorName", "mediaType", "mediaUrls", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment under a post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorPhotoURL": { "type": "string", "maxLength": 2048 },
        "text": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "postId", "authorId", "authorName", "text", "createdAt"]
    },
    "Like": {
      "title": "Like",
      "description": "Like record on a post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userPhotoURL": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "postId", "userId", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Friend request between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderPhotoURL": { "type": "string", "maxLength": 2048 },
        "receiverId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "senderId", "receiverId", "status", "createdAt"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Established friendship record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userA": { "type": "string", "maxLength": 128 },
        "userB": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userA", "userB", "createdAt"]
    },
    "Follow": {
      "title": "Follow",
      "description": "Follow relationship",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "followerId": { "type": "string", "maxLength": 128 },
        "followingId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "followerId", "followingId", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat thread between users or with AI",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "participants": { "type": "array" },
        "isAiAssistant": { "type": "boolean" },
        "lastMessage": { "type": "string", "maxLength": 1000 },
        "lastSenderId": { "type": "string", "maxLength": 128 },
        "lastMessageAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "participants", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Message inside a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderPhotoURL": { "type": "string", "maxLength": 2048 },
        "text": { "type": "string", "maxLength": 2000 },
        "mediaType": { "type": "string", "enum": ["text", "image", "voice"] },
        "mediaUrl": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "conversationId", "senderId", "text", "mediaType", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Persistent notification item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "recipientId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderPhotoURL": { "type": "string", "maxLength": 2048 },
        "type": { "type": "string", "enum": ["like", "comment", "friend_request", "friend_accepted", "new_follower", "gallery_consent", "system"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 500 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "recipientId", "type", "text", "isRead", "createdAt"]
    },
    "Gallery": {
      "title": "Gallery",
      "description": "Private client photography delivery gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "clientName": { "type": "string", "maxLength": 100 },
        "clientEmail": { "type": "string", "maxLength": 120 },
        "clientPhone": { "type": "string", "maxLength": 50 },
        "accessCode": { "type": "string", "maxLength": 64 },
        "accessLinkToken": { "type": "string", "maxLength": 128 },
        "coverUrl": { "type": "string", "maxLength": 2048 },
        "clientConsentStatus": { "type": "string", "enum": ["pending", "authorized", "declined"] },
        "clientConsentDate": { "type": "string", "maxLength": 50 },
        "qualityMode": { "type": "string", "enum": ["high", "watermark_preview"] },
        "photoCount": { "type": "number" },
        "downloadCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "accessLinkToken", "clientConsentStatus", "qualityMode", "createdAt"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "An image item in a client gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "galleryId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 100 },
        "previewUrl": { "type": "string", "maxLength": 2048 },
        "originalUrl": { "type": "string", "maxLength": 2048 },
        "fileSize": { "type": "number" },
        "aspectRatio": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "galleryId", "previewUrl", "originalUrl", "createdAt"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Site global branding and admin configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "heroImageUrl": { "type": "string", "maxLength": 2048 },
        "heroTitle": { "type": "string", "maxLength": 100 },
        "heroSubtitle": { "type": "string", "maxLength": 300 },
        "studioName": { "type": "string", "maxLength": 100 },
        "studioPhone": { "type": "string", "maxLength": 50 },
        "studioWhatsApp": { "type": "string", "maxLength": 50 },
        "primaryColor": { "type": "string", "maxLength": 20 },
        "enableAiAssistant": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "heroImageUrl", "heroTitle", "studioName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin authorization records"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Feed posts"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Comments under posts"
    },
    "/posts/{postId}/likes/{likeId}": {
      "schema": { "$ref": "#/entities/Like" },
      "description": "Likes under posts"
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Friend requests"
    },
    "/friendships/{friendshipId}": {
      "schema": { "$ref": "#/entities/Friendship" },
      "description": "Friendships between users"
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/Follow" },
      "description": "User follow relations"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Direct message conversations"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages inside conversation"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications"
    },
    "/galleries/{galleryId}": {
      "schema": { "$ref": "#/entities/Gallery" },
      "description": "Private client galleries"
    },
    "/galleries/{galleryId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Items in private galleries"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSetting" },
      "description": "Site global settings"
    }
  }
}
